# Optional locally. Required on Vercel: use a Supabase/PostgreSQL connection URL.
DATABASE_URL=
# Optional provider CA in PEM format; literal \n sequences are accepted.
DATABASE_CA_CERT=
# Persisted, real local PostgreSQL when DATABASE_URL is absent.
WASL_DATA_DIR=.wasl-data
APP_URL=http://localhost:3000
# API credentials stay on the server. Core features work without these keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GOOGLE_CLOUD_VISION_API_KEY=
# Bound spending by the number of paid calls allowed per account each UTC day.
WASL_DAILY_AI_LIMIT=50
WASL_DAILY_OCR_LIMIT=20
WASL_PROJECT_AI_LIMIT=500
WASL_PROJECT_OCR_LIMIT=100
# Only enable if your reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
