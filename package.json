{
  "name": "wasl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:e2e": "playwright test",
    "test:postgres": "tsx --test tests/postgres.integration.ts",
    "format:check": "prettier --check src scripts tests '*.ts' '*.json'"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@next/env": "16.4.3",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "openai": "7.43.0",
    "postgres": "3.4.8",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58",
    "@types/node": "^24",
    "@types/qrcode": "^1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.10",
    "tsx": "^4.21",
    "typescript": "^5.9"
  }
}
